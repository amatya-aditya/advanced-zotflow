{
    "name": "advanced-zotflow",
    "version": "1.1.0",
    "description": "Keep your research in flow!",
    "main": "main.js",
    "type": "module",
    "scripts": {
        "generate-zotero-item-schema": "node scripts/generate-zotero-item-schema.js",
        "dev:reader": "cd reader/reader && npm install && webpack --config webpack.obsidian.js --mode development --watch",
        "dev:plugin": "node esbuild.config.mjs",
        "build": "npm run build:reader && npm run build:plugin",
        "build:ci": "npm run build:pdf.js && npm run build:reader && npm run build:plugin",
        "build:pdf.js": "cd reader/reader && npm run build:pdf.js",
        "build:reader": "cd reader/reader && npm install && webpack --config webpack.obsidian.js --mode production",
        "build:plugin": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
        "version": "node version-bump.mjs && git add manifest.json versions.json",
        "lint": "eslint .",
        "sync:upstream:prep": "powershell -ExecutionPolicy Bypass -File scripts/sync-upstream.ps1",
        "update:document-worker": "node scripts/update-document-worker-lock.mjs",
        "memory:watch": "node scripts/obsidian-memory-watch.mjs",
        "typecheck:tests": "tsc -p tests/tsconfig.json",
        "test:vitest": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test": "npm run lint && npm run typecheck:tests && npm run test:vitest"
    },
    "keywords": [],
    "license": "AGPL-3.0-only",
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@lezer/generator": "^1.8.0",
        "@types/node": "^22.15.17",
        "@types/react": "^18.3.28",
        "@types/react-dom": "^18.3.7",
        "@types/spark-md5": "^3.0.5",
        "esbuild": "^0.28.1",
        "eslint-plugin-obsidianmd": "^0.4.1",
        "globals": "^17.8.0",
        "jiti": "^2.6.1",
        "prettier": "^3.9.6",
        "tslib": "^2.8.1",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.65.0",
        "webpack": "^5.109.2",
        "webpack-cli": "^7.2.2",
        "@obsidian-typings/obsidian-public-1.13.4": "1.3.0",
        "@vitest/coverage-v8": "^4.1.10",
        "eslint": "^9.39.4",
        "fake-indexeddb": "^6.2.5",
        "obsidian": "1.13.1",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "@sinclair/typebox": "^0.34.48",
        "@types/nunjucks": "^3.2.6",
        "@xyflow/react": "^12.10.1",
        "clsx": "^2.1.1",
        "comlink": "^4.4.2",
        "dexie": "^4.4.4",
        "fflate": "^0.8.3",
        "hast-util-to-html": "^9.0.5",
        "hast-util-to-mdast": "^10.1.2",
        "hast-util-to-text": "^4.0.2",
        "hastscript": "^9.0.1",
        "json-logic-engine": "^5.0.6",
        "liquidjs": "^10.27.2",
        "mdast-util-gfm-strikethrough": "^2.0.0",
        "mdast-util-gfm-table": "^2.0.0",
        "mdast-util-to-markdown": "^2.1.2",
        "monkey-around": "^3.0.0",
        "p-limit": "^7.3.1",
        "penpal": "^7.0.6",
        "react": "^18.3.1",
        "react-arborist": "^3.16.0",
        "react-dom": "^18.3.1",
        "react-querybuilder": "^8.14.0",
        "rehype-parse": "^9.0.1",
        "rehype-remark": "^10.0.1",
        "rehype-stringify": "^10.0.1",
        "remark-gfm": "^4.0.1",
        "remark-math": "^6.0.0",
        "remark-parse": "^11.0.0",
        "remark-rehype": "^11.1.2",
        "remark-stringify": "^11.0.0",
        "spark-md5": "^3.0.2",
        "stream-browserify": "^3.0.0",
        "unified": "^11.0.5",
        "unist-util-visit": "^5.1.0",
        "uuid": "^14.0.1",
        "zotero-api-client": "^0.51.0",
        "zustand": "^5.0.11",
        "@codemirror/state": "6.5.0",
        "@codemirror/view": "6.38.6",
        "@leeoniya/ufuzzy": "^1.0.19",
        "citeproc": "^2.4.63",
        "mdast-util-gfm-autolink-literal": "^2.0.1",
        "mdast-util-gfm-task-list-item": "^2.0.0",
        "mdast-util-math": "^3.0.0",
        "micromark-extension-gfm-autolink-literal": "^2.1.0",
        "micromark-extension-gfm-strikethrough": "^2.1.0",
        "micromark-extension-gfm-table": "^2.1.1",
        "micromark-extension-gfm-task-list-item": "^2.1.0",
        "unist-util-visit-parents": "^6.0.2"
    }
}
